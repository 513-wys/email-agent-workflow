# ============ TraceInbox configuration ============
# Copy this file to .env, then fill only the values needed for your mode.

# --- DeepSeek (OpenAI-compatible cloud model) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Local Ollama (optional privacy-first inference) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Mailbox access (IMAP) ---
# Use an app-specific password or provider authorization code, never a normal mailbox password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Demo mode uses built-in synthetic messages and does not connect to a real mailbox.
DEMO_MODE=true

# --- Telegram (legacy optional notifications; not part of the current v1 UI) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web service ---
HOST=127.0.0.1
PORT=8000

# Public course demo: uses synthetic data, disables mailbox/settings writes,
# and never calls an external model. Keep false for personal local use.
PUBLIC_DEMO=false

# Hosted multi-user mode. Production values must be long, random secrets.
MULTI_USER_MODE=false
COOKIE_SECURE=false
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=
