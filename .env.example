# ============ AI Email Assistant 配置 ============
# 复制为 .env 后填写

# --- DeepSeek（默认大模型，OpenAI 兼容）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 本地 Ollama（可选，隐私优先时用；不填则走 DeepSeek）---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- 邮件接入（IMAP）---
# Gmail 需开启两步验证并生成「应用专用密码」；Outlook/QQ/163 同理
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# 演示模式：true 时使用内置示例邮件，不连真实邮箱（首次体验推荐）
DEMO_MODE=true

# --- Telegram（可选：告警 + 晨报推送，不填则不推）---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web 服务 ---
HOST=127.0.0.1
PORT=8000

# Public course demo: uses synthetic data, disables mailbox/settings writes,
# and never calls an external model. Keep false for personal local use.
PUBLIC_DEMO=false

# Hosted multi-user mode. Production values must be long, random secrets.
MULTI_USER_MODE=false
COOKIE_SECURE=false
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=
